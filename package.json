{
  "name": "urgrowup-smart-doorbell",
  "version": "1.0.0",
  "description": "Production-ready High-Availability Smart QR Doorbell SaaS (WebRTC + Telegram + Cloudflare Tunnel)",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client && npm run build:server",
    "start": "npm --prefix server run start",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run db:studio",
    "qr:batch": "npm --prefix server run qr:batch",
    "generate:batch": "tsx scripts/generate-batch.ts"
  },
  "keywords": [
    "webrtc",
    "doorbell",
    "telegram",
    "socketio",
    "react",
    "tailwindcss",
    "p2p-audio"
  ],
  "author": "UrGrowUp Tech Team",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
