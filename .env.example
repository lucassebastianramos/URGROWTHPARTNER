# ==============================================================================
# URGROWUP SMART DOORBELL SAAS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL (Domain in production)
APP_URL=https://urgrowup.com
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker & Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=doorbell_user
POSTGRES_PASSWORD=doorbell_secure_pass_2026
POSTGRES_DB=doorbell_db
POSTGRES_PORT=5432

# Database Connection URL (Used by Prisma ORM)
# Inside Docker network: host is 'postgres'
DATABASE_URL="postgresql://doorbell_user:doorbell_secure_pass_2026@postgres:5432/doorbell_db?schema=public"
# For local host development without docker, use:
# DATABASE_URL="postgresql://doorbell_user:doorbell_secure_pass_2026@localhost:5432/doorbell_db?schema=public"

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
# High-entropy secret for signing ephemeral resident call tokens
JWT_SECRET=change_this_to_a_long_random_secret_in_production_9f8e7d6c5b4a3

# Token validity in seconds (default: 10 minutes = 600s)
TOKEN_EXPIRES_IN_SECONDS=600

# ------------------------------------------------------------------------------
# Telegram Bot Integration (Instant Resident Notifications)
# ------------------------------------------------------------------------------
# Obtain from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotToken_FromBotFather
# Optional fallback chat ID for notifications if user has no telegramChatId assigned
TELEGRAM_DEFAULT_CHAT_ID=

# ------------------------------------------------------------------------------
# Anti-Spam & WebRTC Call Policies
# ------------------------------------------------------------------------------
# Call ringing timeout before marking as MISSED (seconds)
CALL_TIMEOUT_SECONDS=45

# Anti-spam rate limit: Max call requests per IP per slug within window
RATE_LIMIT_MAX_CALLS=2
RATE_LIMIT_WINDOW_SECONDS=60

# WebRTC STUN Server
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ------------------------------------------------------------------------------
# Cloudflare Tunnel Configuration
# ------------------------------------------------------------------------------
# Generated in Cloudflare Zero Trust Dashboard -> Access -> Tunnels
TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZS10b2tlbi1yZXBsYWNlLXdpdGgteW91ci1vd24tdG9rZW4ifQ==
